# --- Game data: never commit. Supplied by the user from a classic install. ---
local-game-data/
*.img
*.dir
*.dff
*.txd
*.ipl
*.ide
*.dat
*.set
*.b   # save slots

# --- External pinned engine checkout (reproduced by scripts/fetch-engine.*) ---
# Not vendored into our history; fetch it with the pinned script instead.
engine/

# --- Build artifacts ---
build/
dist/
*.wasm
*.wasm.map
# Exception: the served engine binary IS shipped (reVC.js is useless without it,
# and the confirmed F2/F3 build is not cheaply reproducible — see engine-patches/).
!web/reVC.wasm
web/public/engine/   # emitted engine glue/wasm copied in for serving

# --- Node / tooling ---
node_modules/
.cache/
*.log
npm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
