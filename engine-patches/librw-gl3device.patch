+// ---------------------------------------------------------------------------
+// F2 stereo spike (Experiment #1): self-contained diagnostic renderer.
+// Raw GLES3, deliberately bypassing RW's matrix pipeline: it takes the WebXR
+// projection and view matrices verbatim (column-major, as GL wants them) and
+// draws a 1 m floor grid + reference cubes. A headset/emulator then shows two
+// scissored eye viewports with correct asymmetric projection and parallax —
+// proving loop ownership + opaque-FB access + projection before the real world
+// is wired through librw's beginUpdate. Called from sdl2.cpp's xrRenderView.
+// Residual GL state (program/VAO/depth) is not restored: during XR the desktop
+// path is parked, and librw re-sets state on the next desktop frame.
+// See docs/STEREO-SPIKE.md.
+// ---------------------------------------------------------------------------
+static struct {
+	bool   inited;
+	GLuint prog, uProj, uView, uModel, uColor;
+	GLuint gridVao, gridVbo; int gridVerts;
+	GLuint cubeVao, cubeVbo; int cubeVerts;
+} gXrDiag = { false };
+
+static GLuint
+xrCompile(GLenum type, const char *src)
+{
+	GLuint s = glCreateShader(type);
+	glShaderSource(s, 1, &src, nil);
+	glCompileShader(s);
+	return s;
+}
+
+static void
+xrModelMat(float *m, float tx, float ty, float tz, float s)
+{
+	// column-major translate * uniform-scale
+	m[0]=s; m[1]=0; m[2]=0;  m[3]=0;
+	m[4]=0; m[5]=s; m[6]=0;  m[7]=0;
+	m[8]=0; m[9]=0; m[10]=s; m[11]=0;
+	m[12]=tx; m[13]=ty; m[14]=tz; m[15]=1.0f;
+}
+
+static void
+xrDiagInit(void)
+{
+	if(gXrDiag.inited) return;
+	gXrDiag.inited = true;
+
+	const char *vs =
+		"#version 300 es\n"
+		"layout(location=0) in vec3 aPos;\n"
+		"uniform mat4 uProj; uniform mat4 uView; uniform mat4 uModel;\n"
+		"void main(){ gl_Position = uProj * uView * uModel * vec4(aPos, 1.0); }\n";
+	const char *fs =
+		"#version 300 es\n"
+		"precision highp float;\n"
+		"uniform vec4 uColor; out vec4 frag;\n"
+		"void main(){ frag = uColor; }\n";
+
+	GLuint v = xrCompile(GL_VERTEX_SHADER, vs);
+	GLuint f = xrCompile(GL_FRAGMENT_SHADER, fs);
+	gXrDiag.prog = glCreateProgram();
+	glAttachShader(gXrDiag.prog, v);
+	glAttachShader(gXrDiag.prog, f);
+	glBindAttribLocation(gXrDiag.prog, 0, "aPos");
+	glLinkProgram(gXrDiag.prog);
+	glDeleteShader(v);
+	glDeleteShader(f);
+	gXrDiag.uProj  = glGetUniformLocation(gXrDiag.prog, "uProj");
+	gXrDiag.uView  = glGetUniformLocation(gXrDiag.prog, "uView");
+	gXrDiag.uModel = glGetUniformLocation(gXrDiag.prog, "uModel");
+	gXrDiag.uColor = glGetUniformLocation(gXrDiag.prog, "uColor");
+
+	// Floor grid on y=0, -5..5 m, 1 m spacing (metres == WebXR units).
+	float grid[(11 + 11) * 2 * 3];
+	int gi = 0;
+	for(int i = -5; i <= 5; i++){
+		grid[gi++] = (float)i; grid[gi++] = 0.0f; grid[gi++] = -5.0f;   // along Z
+		grid[gi++] = (float)i; grid[gi++] = 0.0f; grid[gi++] =  5.0f;
+		grid[gi++] = -5.0f; grid[gi++] = 0.0f; grid[gi++] = (float)i;   // along X
+		grid[gi++] =  5.0f; grid[gi++] = 0.0f; grid[gi++] = (float)i;
+	}
+	gXrDiag.gridVerts = gi / 3;
+	glGenVertexArrays(1, &gXrDiag.gridVao);
+	glBindVertexArray(gXrDiag.gridVao);
+	glGenBuffers(1, &gXrDiag.gridVbo);
+	glBindBuffer(GL_ARRAY_BUFFER, gXrDiag.gridVbo);
+	glBufferData(GL_ARRAY_BUFFER, gi * sizeof(float), grid, GL_STATIC_DRAW);
+	glEnableVertexAttribArray(0);
+	glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 3 * sizeof(float), 0);
+
+	// Unit cube centered at origin (36 verts, no index buffer; culling is off).
+	static const float cube[] = {
+		-0.5f,-0.5f, 0.5f,  0.5f,-0.5f, 0.5f,  0.5f, 0.5f, 0.5f,
+		-0.5f,-0.5f, 0.5f,  0.5f, 0.5f, 0.5f, -0.5f, 0.5f, 0.5f,
+		 0.5f,-0.5f,-0.5f, -0.5f,-0.5f,-0.5f, -0.5f, 0.5f,-0.5f,
+		 0.5f,-0.5f,-0.5f, -0.5f, 0.5f,-0.5f,  0.5f, 0.5f,-0.5f,
+		-0.5f,-0.5f,-0.5f, -0.5f,-0.5f, 0.5f, -0.5f, 0.5f, 0.5f,
+		-0.5f,-0.5f,-0.5f, -0.5f, 0.5f, 0.5f, -0.5f, 0.5f,-0.5f,
+		 0.5f,-0.5f, 0.5f,  0.5f,-0.5f,-0.5f,  0.5f, 0.5f,-0.5f,
+		 0.5f,-0.5f, 0.5f,  0.5f, 0.5f,-0.5f,  0.5f, 0.5f, 0.5f,
+		-0.5f, 0.5f, 0.5f,  0.5f, 0.5f, 0.5f,  0.5f, 0.5f,-0.5f,
+		-0.5f, 0.5f, 0.5f,  0.5f, 0.5f,-0.5f, -0.5f, 0.5f,-0.5f,
+		-0.5f,-0.5f,-0.5f,  0.5f,-0.5f,-0.5f,  0.5f,-0.5f, 0.5f,
+		-0.5f,-0.5f,-0.5f,  0.5f,-0.5f, 0.5f, -0.5f,-0.5f, 0.5f,
+	};
+	gXrDiag.cubeVerts = 36;
+	glGenVertexArrays(1, &gXrDiag.cubeVao);
+	glBindVertexArray(gXrDiag.cubeVao);
+	glGenBuffers(1, &gXrDiag.cubeVbo);
+	glBindBuffer(GL_ARRAY_BUFFER, gXrDiag.cubeVbo);
+	glBufferData(GL_ARRAY_BUFFER, sizeof(cube), cube, GL_STATIC_DRAW);
+	glEnableVertexAttribArray(0);
+	glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 3 * sizeof(float), 0);
+
+	glBindVertexArray(0);
+}
+
+void
+xrDrawDiagnostic(int eye, int x, int y, int w, int h, const float *proj, const float *view)
+{
+	xrDiagInit();
+
+	glViewport(x, y, w, h);
+	glScissor(x, y, w, h);
+	glEnable(GL_SCISSOR_TEST);
+
+	// Distinct per-eye tint so even a geometry-less frame still shows both
+	// scissored viewports and which eye is which.
+	if(eye == 0) glClearColor(0.06f, 0.01f, 0.01f, 1.0f);
+	else         glClearColor(0.01f, 0.01f, 0.08f, 1.0f);
+	glDepthMask(GL_TRUE);
+	glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+
+	glEnable(GL_DEPTH_TEST);
+	glDepthFunc(GL_LEQUAL);
+	glDisable(GL_CULL_FACE);
+
+	glUseProgram(gXrDiag.prog);
+	glUniformMatrix4fv(gXrDiag.uProj, 1, GL_FALSE, proj);
+	glUniformMatrix4fv(gXrDiag.uView, 1, GL_FALSE, view);
+
+	float m[16];
+	xrModelMat(m, 0, 0, 0, 1.0f);
+	glUniformMatrix4fv(gXrDiag.uModel, 1, GL_FALSE, m);
+	glUniform4f(gXrDiag.uColor, 0.45f, 0.45f, 0.45f, 1.0f);
+	glBindVertexArray(gXrDiag.gridVao);
+	glDrawArrays(GL_LINES, 0, gXrDiag.gridVerts);
+
+	// Reference cubes at known metre positions: ahead, right, left, high.
+	static const float cubes[][7] = {
+		{  0.0f, 0.5f, -2.0f, 0.5f, 0.9f, 0.2f, 0.2f },
+		{  1.2f, 0.5f, -2.5f, 0.5f, 0.2f, 0.9f, 0.2f },
+		{ -1.2f, 0.5f, -2.5f, 0.5f, 0.2f, 0.5f, 0.9f },
+		{  0.0f, 1.6f, -3.5f, 0.5f, 0.9f, 0.9f, 0.2f },
+	};
+	glBindVertexArray(gXrDiag.cubeVao);
+	for(int i = 0; i < 4; i++){
+		xrModelMat(m, cubes[i][0], cubes[i][1], cubes[i][2], cubes[i][3]);
+		glUniformMatrix4fv(gXrDiag.uModel, 1, GL_FALSE, m);
+		glUniform4f(gXrDiag.uColor, cubes[i][4], cubes[i][5], cubes[i][6], 1.0f);
+		glDrawArrays(GL_TRIANGLES, 0, gXrDiag.cubeVerts);
+	}
+
+	glBindVertexArray(0);
+	glUseProgram(0);
+	glDisable(GL_SCISSOR_TEST);
+}
+
 Device renderdevice = {
 	-1.0f, 1.0f,
 	gl3::beginUpdate,
