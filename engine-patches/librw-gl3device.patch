+// F2 obstacle #4: verbatim-matrix mode. When set, the crude eye-offset + aspect
+// hack + head-rotation path is bypassed entirely; the host supplies the real
+// per-eye projection (RW convention) and a view DELTA that is left-multiplied
+// onto the engine's own camera view. See web/src/xr-engine/xr-rw.js for how JS
+// converts the WebXR GL matrices into these. Both are column-major float[16].
+static bool  gXrVerbatim = false;
+static float gXrProjM[16];       // host-supplied RW projection (P_rw = P_gl·M)
+static float gXrViewDelta[16];   // host-supplied view delta (Δ = M·viewInv·M)
+
+// out = a · b, column-major 4x4. out must not alias a or b.
+static void xrMat4Mul(float *o, const float *a, const float *b) {
+	for(int c = 0; c < 4; c++)
+		for(int r = 0; r < 4; r++)
+			o[c*4+r] = a[0*4+r]*b[c*4+0] + a[1*4+r]*b[c*4+1] +
+			           a[2*4+r]*b[c*4+2] + a[3*4+r]*b[c*4+3];
+}
+
+void xrStereoSet(float eyeOff, int x, int y, int w, int h) {
+	gXrStereo = true; gXrVerbatim = false; gXrEyeOff = eyeOff;
+	gXrVp2[0] = x; gXrVp2[1] = y; gXrVp2[2] = w; gXrVp2[3] = h;
+	glGlobals.presentWidth = -1;   // invalidate cached viewport
+}
+// Verbatim real-matrix stereo: proj/view are the converted WebXR matrices.
+void xrStereoSetM(const float *proj, const float *viewDelta, int x, int y, int w, int h) {
+	gXrStereo = true; gXrVerbatim = true;
+	memcpy(gXrProjM, proj, 16*sizeof(float));
+	memcpy(gXrViewDelta, viewDelta, 16*sizeof(float));
+	gXrVp2[0] = x; gXrVp2[1] = y; gXrVp2[2] = w; gXrVp2[3] = h;
+	glGlobals.presentWidth = -1;   // invalidate cached viewport
+}
+void xrStereoOff(void) { gXrStereo = false; gXrVerbatim = false; gHeadYaw = gHeadPitch = 0.0f; glGlobals.presentWidth = -1; }
+// Head look (radians), applied in the override below (crude path only). Set per
+// frame from the WebXR head pose; 0 = straight ahead.
+void xrHeadSet(float yaw, float pitch) { gHeadYaw = yaw; gHeadPitch = pitch; }
