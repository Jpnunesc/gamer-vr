+
+#ifdef __EMSCRIPTEN__
+// ---------------------------------------------------------------------------
+// F2 stereo spike (Experiment #1): XR loop-ownership + diagnostic draw bridge.
+// NEW contracts (plan §4), not production exports. The JS XR rAF loop parks this
+// module's own game loop (see __viceXrActive in reVCYieldFrame above) and calls
+// the xr* exports below from inside XRSession.requestAnimationFrame, so every GL
+// draw lands in the opaque XRWebGLLayer framebuffer while it is bound and valid.
+// See docs/STEREO-SPIKE.md.
+// ---------------------------------------------------------------------------
+namespace rw { namespace gl3 {
+	void xrDrawDiagnostic(int eye, int x, int y, int w, int h, const float *proj, const float *view);
+	void xrStereoSet(float eyeOff, int x, int y, int w, int h);
+	void xrStereoSetM(const float *proj, const float *viewDelta, int x, int y, int w, int h);
+	void xrStereoOff(void);
+	void xrHeadSet(float yaw, float pitch);
+}}
+
+static volatile int gViceXrActive = 0;
+static volatile int gViceDiagReady = 0;   // 1 once the diag-boot spin is reached (GL up, game not loaded)
+// Per-eye matrices written by JS via HEAPF32 through the pointers below. The heap
+// never grows (ALLOW_MEMORY_GROWTH=0), so these addresses stay valid.
+static float gXrProj[16];
+static float gXrView[16];
+static int   gXrViewCount = 0;   // views drawn since entering XR (the "N" of 1-update/N-views)
+// F2 obstacle #4: per-eye REAL matrices staged by JS (converted from WebXR; see
+// web/src/xr-engine/xr-rw.js). Written through the pointers below, consumed by
+// xrStereoEyeM. The heap never grows, so these addresses stay valid.
+static float gXrStereoProj[16];  // P_rw (converted WebXR projection)
+static float gXrStereoView[16];  // Δ   (converted per-eye view delta)
+
+EM_JS(void, reVCXrSetModeJS, (int enabled), {
+	globalThis.__viceXrActive = enabled;
+	if (!enabled && globalThis.__viceXrUnpark) {
+		var resume = globalThis.__viceXrUnpark;
+		globalThis.__viceXrUnpark = null;
+		resume();              // let the parked desktop loop resume, exactly once
+	}
+});
+
+// F2 spike: when set by the host before boot, hold the loop before it loads the
+// game (see the main loop). Read every frame; a JS global, so no export needed.
+EM_JS(int, reVCDiagHaltJS, (), { return globalThis.__viceDiagHalt ? 1 : 0; });
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE void   xrSetMode(int enabled) { gViceXrActive = enabled; if(enabled) gXrViewCount = 0; reVCXrSetModeJS(enabled); }
+EMSCRIPTEN_KEEPALIVE int    xrIsActive(void)       { return gViceXrActive; }
+EMSCRIPTEN_KEEPALIVE int    xrViewCount(void)      { return gXrViewCount; }
+EMSCRIPTEN_KEEPALIVE float *xrProjPtr(void)        { return gXrProj; }
+EMSCRIPTEN_KEEPALIVE float *xrViewPtr(void)        { return gXrView; }
+EMSCRIPTEN_KEEPALIVE void   xrRenderView(int eye, int x, int y, int w, int h) {
+	rw::gl3::xrDrawDiagnostic(eye, x, y, w, h, gXrProj, gXrView);
+	gXrViewCount++;
+}
+EMSCRIPTEN_KEEPALIVE int    xrDiagReady(void)      { return gViceDiagReady; }
+// F2 step 2: per-eye stereo override. eye 0 = left (-ipd/2), eye 1 = right (+ipd/2);
+// x,y,w,h is this eye's viewport in the host-bound framebuffer.
+EMSCRIPTEN_KEEPALIVE void   xrStereoEye(int eye, float ipd, int x, int y, int w, int h) {
+	rw::gl3::xrStereoSet((eye == 0 ? -0.5f : 0.5f) * ipd, x, y, w, h);
+}
+// Real-matrix stereo (obstacle #4): JS has already written the converted P_rw
+// into xrStereoProjPtr() and Δ into xrStereoViewPtr() for THIS eye; this hands
+// them to librw's verbatim override and sets the eye viewport.
+EMSCRIPTEN_KEEPALIVE float *xrStereoProjPtr(void) { return gXrStereoProj; }
+EMSCRIPTEN_KEEPALIVE float *xrStereoViewPtr(void) { return gXrStereoView; }
+EMSCRIPTEN_KEEPALIVE void   xrStereoEyeM(int x, int y, int w, int h) {
+	rw::gl3::xrStereoSetM(gXrStereoProj, gXrStereoView, x, y, w, h);
+}
+EMSCRIPTEN_KEEPALIVE void   xrStereoDone(void)     { rw::gl3::xrStereoOff(); }
+// Head look (radians), from the WebXR head pose. Applied to both eyes' views.
+EMSCRIPTEN_KEEPALIVE void   xrHeadSet(float yaw, float pitch) { rw::gl3::xrHeadSet(yaw, pitch); }
+
+// Diag boot: the RW/WebGL2 device is up but the game is NOT initialised. Spin a
+// yield loop so the page stays alive and the stereo bridge can drive the live
+// context with no data. Called from Initialise3D (main.cpp) right after the RW
+// device comes up. Never returns; parks inside reVCYieldFrame when XR takes over.
+void reVCDiagSpin(void) { gViceDiagReady = 1; for(;;){ reVCFrames++; reVCYieldFrame(); } }
+} // extern "C"
+#endif
