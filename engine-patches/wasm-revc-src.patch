+#ifdef __EMSCRIPTEN__
+// F3 first-person: when enabled, the world is rendered from the player's head
+// (position + eye height, body heading as the base look direction) and the player
+// model is hidden. The XR head pose rides on top via the librw view delta
+// (gl3device.cpp), so look is decoupled from the body. The game camera is left to
+// the sim; we only re-pose the RW render camera for the draw and restore the
+// player's visibility on the next sim tick. See docs/WALKING-TEST.md.
+static bool  gXrFirstPerson = false;
+static float gXrEyeHeight   = 0.5f;   // metres above the ped origin; host-tunable
+static float gXrCullVW      = 2.0f;   // cull view-window half-extent (~127° FOV); host-tunable
+static CPlayerPed *gXrHiddenPed = nil;
+static bool  gXrHiddenPedVis = true;
+
+extern "C" EMSCRIPTEN_KEEPALIVE void
+xrSetFirstPerson(int on, float eyeHeight)
+{
+	gXrFirstPerson = on != 0;
+	if(eyeHeight > 0.0f) gXrEyeHeight = eyeHeight;
+}
+
+// Live-tune the cull frustum width (half-extent at unit distance; 1.0≈90°,
+// 2.0≈127°, 3.0≈143°). Wider = fewer "holes" when the head turns, more geometry.
+extern "C" EMSCRIPTEN_KEEPALIVE void
+xrSetCullVW(float vw)
+{
+	if(vw > 0.1f) gXrCullVW = vw;
+}
+
+// Jump the in-game clock (makes dusk/night scenes legible for testing — e.g. noon
+// to see the road textured in daylight). The sim keeps advancing from here.
+extern "C" EMSCRIPTEN_KEEPALIVE void
+xrSetTime(int h, int m)
+{
+	CClock::SetGameClock((uint8)h, (uint8)m);
+}
+
+// Pose the RW render camera at the player's head, looking along the body heading.
+// Head pitch/roll/6DoF come from the XR pose (the view delta), so here the base is
+// a level camera facing the body direction. Mirrors CCamera's RW-frame posing.
+// Diagnostic readout (host reads via xrEyeInfoPtr): eye xyz, player coors xyz,
+// heading, ground-Z under the player. Lets us see WHERE the eye actually is.
+static float gXrEyeInfo[8];
+extern "C" EMSCRIPTEN_KEEPALIVE float *xrEyeInfoPtr(void) { return gXrEyeInfo; }
+
+static void
+xrPoseFirstPersonCamera(void)
+{
+	if(FindPlayerPed() == nil) return;
+	CVector coors = FindPlayerCoors();
+	CVector pos = coors;
+	pos.z += gXrEyeHeight;
+	float h = FindPlayerHeading();
+	CVector fwd(-sinf(h), cosf(h), 0.0f);   // re3 heading convention; flip if reversed
+	CVector up(0.0f, 0.0f, 1.0f);
+	CVector right = CrossProduct(up, fwd);
+	RwFrame *frame = RwCameraGetFrame(Scene.camera);
+	RwMatrix *rwm = RwFrameGetMatrix(frame);
+	*RwMatrixGetPos(rwm)   = pos;
+	*RwMatrixGetAt(rwm)    = fwd;
+	*RwMatrixGetUp(rwm)    = up;
+	*RwMatrixGetRight(rwm) = right;
+	RwMatrixUpdate(rwm);
+	RwFrameUpdateObjects(frame);
+	RwFrameOrthoNormalize(frame);
+
+	gXrEyeInfo[0] = pos.x;   gXrEyeInfo[1] = pos.y;   gXrEyeInfo[2] = pos.z;
+	gXrEyeInfo[3] = coors.x; gXrEyeInfo[4] = coors.y; gXrEyeInfo[5] = coors.z;
+	gXrEyeInfo[6] = h;
+	gXrEyeInfo[7] = CWorld::FindGroundZForCoord(coors.x, coors.y);
+}
+
+static void xrHidePlayerForRender(void) {
+	CPlayerPed *p = FindPlayerPed();
+	if(p){ gXrHiddenPed = p; gXrHiddenPedVis = p->bIsVisible; p->bIsVisible = false; }
+}
+static void xrRestorePlayerVisibility(void) {
+	if(gXrHiddenPed){ gXrHiddenPed->bIsVisible = gXrHiddenPedVis; gXrHiddenPed = nil; }
+}
+
+// F2 step 2 bridge: one sim tick + per-eye world render, driven from JS while the
+// engine's own loop is parked (xrSetMode). No 2D/HUD/present here. The librw stereo
+// override (gl3device.cpp) owns the per-eye viewport/scissor. See docs/STEREO-SPIKE.md.
+extern "C" EMSCRIPTEN_KEEPALIVE void
+xrGameAdvance(void)
+{
+	xrRestorePlayerVisibility();   // the player is only hidden during the render
+	Idle(nil);   // sim only: returns at the arg==nil check, before any render
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void
+xrRenderWorld(int buildList)
+{
+	PUSH_MEMID(MEMID_RENDER);
+	if(gXrFirstPerson) xrPoseFirstPersonCamera();   // re-pose every eye (cheap)
+	if(buildList){
+		RwV2d savedVw;
+		bool widened = false;
+		if(gXrFirstPerson){
+			xrHidePlayerForRender();  // hide before the list is built
+			// Widen the cull frustum. ScanWorld culls to the game camera's view
+			// window, but we render a wider per-eye FOV and the head turns via the
+			// XR view delta — so the normal (narrow) frustum culls the periphery and
+			// we "see between the walls". The verbatim render ignores this view
+			// window (it uses the staged projection), so widening ONLY adds geometry
+			// to the render list — it can never remove any. ~127° covers the eye FOV
+			// plus a generous head-turn margin.
+			savedVw = *RwCameraGetViewWindow(Scene.camera);
+			RwV2d wide; wide.x = gXrCullVW; wide.y = gXrCullVW;
+			RwCameraSetViewWindow(Scene.camera, &wide);
+			widened = true;
+		}
+		CRenderer::ConstructRenderList();
+		CRenderer::PreRender();
+		if(widened) RwCameraSetViewWindow(Scene.camera, &savedVw);
+	}
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void *)FALSE);
+	RwCameraSetFarClipPlane(Scene.camera, CTimeCycle::GetFarClip());
+	RwCameraSetFogDistance(Scene.camera, CTimeCycle::GetFogStart());
+	if(!DoRWStuffStartOfFrame_Horizon(CTimeCycle::GetSkyTopRed(), CTimeCycle::GetSkyTopGreen(), CTimeCycle::GetSkyTopBlue(),
+			CTimeCycle::GetSkyBottomRed(), CTimeCycle::GetSkyBottomGreen(), CTimeCycle::GetSkyBottomBlue(), 255)){
+		POP_MEMID();
+		return;
+	}
+	DefinedState();
+	RenderScene();
+	RenderEffects();
+	RwCameraEndUpdate(Scene.camera);   // close the camera; NO ShowRaster (no present)
+	POP_MEMID();
+}
+#endif
+
