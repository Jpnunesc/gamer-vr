+// F3 locomotion: the host injects a movement vector (WASD / VR stick) here; we
+// overwrite pad 0's left stick at the END of UpdatePads, AFTER the real input is
+// read, so the native player-control / physics / collision move Tommy (plan §6
+// F3: "encaminhar movimento para colisão e física nativas... mesmas ações de
+// gameplay"). Movement is camera-relative (PlayerPed uses TheCamera.Orientation);
+// our first-person camera faces the body heading, so WASD is body-relative.
+static bool  gXrMoveActive = false;
+static int16 gXrMoveX = 0, gXrMoveY = 0;
+extern "C" EMSCRIPTEN_KEEPALIVE void xrSetMove(float fwd, float strafe) {
+	gXrMoveActive = true;
+	// Full deflection is ~128 (see the joystick mapping in CapturePad). Forward
+	// maps to NEGATIVE LeftStickY (re3 keyboard convention: LeftStickY = -ly*128).
+	gXrMoveY = (int16)(-fwd * 127.0f);
+	gXrMoveX = (int16)(strafe * 127.0f);
+}
+extern "C" EMSCRIPTEN_KEEPALIVE void xrClearMove(void) { gXrMoveActive = false; gXrMoveX = gXrMoveY = 0; }
+#endif
